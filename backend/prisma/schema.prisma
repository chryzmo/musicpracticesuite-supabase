generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                @id @default(uuid())
  authId               String                @unique
  email                String                @unique
  displayName          String?
  instrument           String?
  createdAt            DateTime              @default(now())
  practiceSessions     PracticeSession[]
  reeds                Reed[]
  sightReadingSessions SightReadingSession[]
}

model PracticeSession {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  date            DateTime @default(now())
  durationMinutes Int
  pieces          String[]
  skills          String[]
  notes           String?
  reedId          String?
  reed            Reed?    @relation(fields: [reedId], references: [id])
  createdAt       DateTime @default(now())
}

model Reed {
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id])
  identifier       String
  reedType         String
  openDate         DateTime
  retireDate       DateTime?
  usageMinutes     Int               @default(0)
  notes            String?
  isActive         Boolean           @default(true)
  practiceSessions PracticeSession[]
  createdAt        DateTime          @default(now())
}

model SightReadingSession {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  date          DateTime @default(now())
  keySignature  String
  timeSignature String
  instrument    String
  noteValues    String[]
  selfRating    Int?
  notes         String?
  createdAt     DateTime @default(now())
}
