# Database
# Use localhost:5432 for local dev (Docker exposes this port to your machine).
# docker-compose.yml overrides this with db:5432 inside containers automatically.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME

# Docker Compose local dev (used to create the PostgreSQL container)
POSTGRES_USER=practiceuser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=musicpractice

# Auth (JWT secret for signing/verifying tokens)
AUTH_SECRET=replace-with-a-long-random-secret

# Anthropic API (for AI Insights feature)
ANTHROPIC_API_KEY=sk-ant-...

# Backend
PORT=3001

# Frontend (Vite — must be prefixed with VITE_)
VITE_API_BASE_URL=http://localhost:3001
