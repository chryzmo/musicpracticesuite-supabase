# Deployment settings for `make deploy`. Copy to .env.production (git-ignored).
# Sourced by bash: quote values that contain spaces or shell characters.

# Supabase project (Project Settings → General → Project ID)
SUPABASE_PROJECT_REF=
# Database password chosen when the project was created; used by `make db-push`
SUPABASE_DB_PASSWORD=

# Baked into the frontend build (Project Settings → API Keys)
# The URL is https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Pages project name (created once with `make pages-create`)
CLOUDFLARE_PAGES_PROJECT=musicpracticesuite

# Edge Function secrets, pushed with `make secrets`
ANTHROPIC_API_KEY=
