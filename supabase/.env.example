# OAuth credentials for the local Supabase stack (read by supabase/config.toml).
# Copy to supabase/.env. Callback URL for both providers when running locally:
#   http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Used by the insights Edge Function under `supabase functions serve`
ANTHROPIC_API_KEY=
