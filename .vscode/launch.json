{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "Full Stack (debug)",
      "configurations": ["Backend (debug)", "Frontend (dev)"],
      "preLaunchTask": "kill: port 3001",
      "stopAll": true
    }
  ],
  "configurations": [
    {
      "name": "Backend (debug)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/backend/src/index.js",
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "env": { "NODE_ENV": "development" },
      "preLaunchTask": "docker: start db",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Frontend (dev)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
