{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "kill: port 3001",
      "type": "shell",
      "command": "$p = (Get-NetTCPConnection -LocalPort 3001 -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -First 1); if ($p) { Stop-Process -Id $p -Force -ErrorAction SilentlyContinue }",
      "options": {
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-Command"]
        }
      },
      "presentation": { "reveal": "silent", "close": true, "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "docker: start db",
      "type": "shell",
      "command": "docker compose up -d --wait db",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "silent", "close": true, "panel": "shared" },
      "problemMatcher": []
    }
  ]
}
